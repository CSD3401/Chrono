            },
            "UIText": {
                "luid": 8392574076272443392,
                "text": "Team B,\n\nI've completed my sweep of the Aether Core maintenance tunnels.\nSecurity is heavier than expected, so I left observations where I could.\nYou'll have to figure out the rest yourselves.\n\nYour first objective is simple: reach the train. \nThat's our transport deeper into the facility. \nTeam A is entering from the upper ventilation shafts.\n If you fall behind, they'll proceed without you.\n\nBring down the capitalist pigs. Viva revolution!\n\n-- Click to Continue --\n",
                "fontUUID": "be474625-2c47-4430-b78a-468cee201eaa",
                "fontSize": 60.0,
                "color": {
                    "x": 1.0,
                    "y": 1.0,
                    "z": 1.0,
                    "w": 1.0
                },
                "horizontalAlign": 1,
                "verticalAlign": 1,
                "wordWrap": 0,
                "autoScale": 0,
                "minFontSize": 10.0,
                "maxFontSize": 100.0
            }
        },
        {
            "Layer": 0,
