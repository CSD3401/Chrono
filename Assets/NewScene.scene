            },
            "UIText": {
                "luid": 8392574076272443393,
                "text": "The access panel routes power through colour-matched conduits. \nThe wires only stabilise when paired with their own kind.\n\n-- Click to Continue --",
                "fontUUID": "be474625-2c47-4430-b78a-468cee201eaa",
